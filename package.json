{
  "name": "lockup",
  "private": true,
  "version": "0.1.0",
  "description": "LOCKUP - sealed-bid storage units on Solana + MagicBlock",
  "scripts": {
    "dev": "pnpm --filter @lockup/web dev",
    "build": "pnpm --filter @lockup/web build",
    "typecheck": "pnpm --filter @lockup/web typecheck",
    "test:program": "cargo test -p lockup --lib",
    "anchor:build": "anchor build",
    "setup:devnet": "tsx scripts/setup.ts",
    "round": "tsx scripts/round.ts"
  },
  "packageManager": "pnpm@11.20.0",
  "devDependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@magicblock-labs/ephemeral-rollups-sdk": "0.16.2",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.0",
    "tweetnacl": "^1.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "@types/node": "^22.10.0"
  }
}